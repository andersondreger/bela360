# ===========================================
# bela360 - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ===========================================
# Application Mode
# ===========================================
NODE_ENV=production
# Para desenvolvimento, use: NODE_ENV=development

# ===========================================
# URLs (ajuste para seu dominio)
# ===========================================
API_URL=https://api.seudominio.com
FRONTEND_URL=https://seudominio.com

# ===========================================
# Database (PostgreSQL)
# ===========================================
# Para Docker, use o nome do servico (postgres)
# Para desenvolvimento local, use localhost
POSTGRES_USER=bela360
POSTGRES_PASSWORD=SuaSenhaForte123
POSTGRES_DB=bela360
DATABASE_URL=postgresql://bela360:SuaSenhaForte123@postgres:5432/bela360

# ===========================================
# Redis
# ===========================================
# Para Docker: redis://redis:6379
# Para local: redis://localhost:6379
REDIS_URL=redis://redis:6379

# ===========================================
# JWT Authentication
# ===========================================
# IMPORTANTE: Gere chaves unicas com: openssl rand -base64 32
JWT_SECRET=gere_uma_chave_aleatoria_aqui
JWT_REFRESH_SECRET=gere_outra_chave_aleatoria_aqui
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ===========================================
# Evolution API (WhatsApp)
# ===========================================
# URL interna Docker
EVOLUTION_API_URL=http://evolution-api:8080
# URL publica (para webhooks)
EVOLUTION_PUBLIC_URL=https://whatsapp.seudominio.com
# Gere uma chave com: openssl rand -hex 16
EVOLUTION_API_KEY=sua_chave_evolution_api
EVOLUTION_INSTANCE_NAME=bela360
# Numero que dispara a 1a mensagem (prospeccao + boas-vindas + OTP de login):
# o numero pessoal do responsavel. Numero que atende o cliente depois (Ana):
# o numero institucional. Vazios = ambos usam EVOLUTION_INSTANCE_NAME.
EVOLUTION_OUTREACH_INSTANCE_NAME=
EVOLUTION_SUPPORT_INSTANCE_NAME=
# Numero publico de atendimento no formato E.164 sem "+" (ex: 5545991397543),
# usado nos links wa.me da landing / login / onboarding.
SUPPORT_WHATSAPP_NUMBER=
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# Teste completo gratis antes de exigir a assinatura (dias)
TRIAL_DAYS=7

# ===========================================
# Next.js (Frontend)
# ===========================================
# URLs publicas para o frontend
NEXT_PUBLIC_API_URL=https://api.seudominio.com
NEXT_PUBLIC_WS_URL=wss://api.seudominio.com

# ===========================================
# Logging & Monitoring
# ===========================================
LOG_LEVEL=info
# Opcional: Sentry para monitoramento de erros
SENTRY_DSN=

# ===========================================
# Rate Limiting
# ===========================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# ===========================================
# Asaas (cobranca da assinatura SaaS do bela360)
# ===========================================
# A chave do Asaas comeca com "$". Como este .env e lido pelo docker compose,
# escape o "$" inicial como "$$" (ex: $$aact_prod_xxxx). O container recebe a
# chave com um "$" so. Fora do docker (rodando a API direto) use so um "$".
ASAAS_API_KEY=sua_chave_de_api_asaas
# sandbox pra testes | production pra cobranca real
ASAAS_ENVIRONMENT=sandbox
ASAAS_WEBHOOK_TOKEN=um_token_secreto_que_voce_inventa_e_cola_no_dashboard_do_asaas
ASAAS_SUBSCRIPTION_VALUE=97

# Marketplace (cashback + split). Fase 1: "simulado". Fase 2: "asaas" (webhooks).
MARKETPLACE_GATEWAY=simulado
# Mesmo valor em MARKETPLACE_SERVICE_TOKEN do payments-api do wayia.com.br (>= 24 caracteres, gere com: openssl rand -hex 24)
MARKETPLACE_SERVICE_TOKEN=
# Asaas do marketplace (credenciais PROPRIAS, separadas da assinatura SaaS). Sandbox primeiro.
# No painel do Asaas: webhook https://bela360.wayia.com.br/api/marketplace/webhooks/asaas com este mesmo token
# (eventos de cobranca), e preencha o CPF/CNPJ da clinica antes de pagar.
MARKETPLACE_ASAAS_API_KEY=
MARKETPLACE_ASAAS_ENV=sandbox
MARKETPLACE_ASAAS_WEBHOOK_TOKEN=

# ===========================================
# Telegram — SÓ canal de alerta interno pro admin. O cliente nunca fala com
# a gente pelo Telegram (atendimento é 100% WhatsApp).
# ===========================================
TELEGRAM_BOT_TOKEN=token_do_bot_gerado_pelo_botfather
TELEGRAM_WEBHOOK_SECRET=um_token_secreto_que_voce_inventa
TELEGRAM_BOT_USERNAME=Bela360bot
# Chat ID do Telegram do admin — recebe alerta quando um OTP/mensagem de
# sistema nao consegue ser entregue pelo WhatsApp (opcional)
ADMIN_TELEGRAM_CHAT_ID=
# Mensagens do marketplace (Fase 3): off | simulado (so registra) | ativo (envia de verdade)
MARKETPLACE_MESSAGES=simulado
# WhatsApp Cloud API OFICIAL (Meta): token permanente + ID do numero; exige templates aprovados (nomes em apps/api/src/modules/marketplace/CLAUDE.md)
MARKETPLACE_WA_TOKEN=
MARKETPLACE_WA_PHONE_ID=
# E-mail transacional (Resend)
MARKETPLACE_EMAIL_API_KEY=
MARKETPLACE_EMAIL_FROM=
